 "lines": [
  [
   "narrator",
   1.0,
   null,
   "He folded his first paper plane on a Monday."
  ],
  [
   "narrator",
   4.6,
   null,
   "It flew for exactly one second."
  ],
  [
   "narrator",
   8.4,
   null,
   "So he folded another. And another."
  ],
  [
   "narrator",
   12.6,
   null,
   "By Friday, the floor was covered in tiny crashes."
  ],
  [
   "narrator",
   17.4,
   null,
   "That night, he almost stopped."
  ],
  [
   "narrator",
   21.6,
   null,
   "Then he noticed something."
  ],
  [
   "narrator",
   24.4,
   null,
   "Every crash had flown a little farther than the one before."
  ],
  [
   "narrator",
   29.6,
   null,
   "So in the morning... he tried one more time."
  ],
  [
   "narrator",
   37.2,
   null,
   "Falling isn't failing. It's how you learn the wind."
  ]
 ],
